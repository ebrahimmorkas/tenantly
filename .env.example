# Copy to .env and adjust. Every value has a sensible default for local development.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite. Example: postgres://tenantly:tenantly@localhost:5432/tenantly
DATABASE_URL=

# Optional. When set, Redis backs the cache (rate limits) and the Celery broker. When empty,
# Tenantly uses an in-memory cache and runs Celery tasks synchronously.
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Tenantly Billing <billing@tenantly.local>
